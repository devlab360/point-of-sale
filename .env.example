# PostgreSQL Local Database Connection (Username: postgres, No password)
DATABASE_URL=postgres://postgres:@localhost:5432/pos_db

# SaaS Trial Duration Config (Defaults to 7 days if omitted)
VITE_TRIAL_DAYS=7

# JWT Secret for Session Tokens
JWT_SECRET=pos-super-secret-key-development

# SMTP Email Verification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NexisPOS SaaS <noreply@NexisPOS>"

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/)
VITE_GOOGLE_CLIENT_ID=

# Facebook OAuth App ID (Get from https://developers.facebook.com/)
VITE_FACEBOOK_APP_ID=

# Super Admin Security Keys (Required for Super Admin Access)
SUPER_ADMIN_KEY=superadmin_secret_key
SUPER_ADMIN_PASSWORD=superadmin_password
BLOB_READ_WRITE_TOKEN=

# Gemini API Key (For AI generation)
GEMINI_API_KEY=

# Meta WhatsApp Cloud API (For automated messaging)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
