# Grocer.Pro SaaS - Environment Variables Config

# SaaS Trial Duration Config (Defaults to 7 days if omitted)
VITE_TRIAL_DAYS=7

# SMTP Email Verification Settings
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=
VITE_SMTP_PASS=
VITE_SMTP_FROM="NexisPOS  SaaS <noreply@NexisPOS>"

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/)
VITE_GOOGLE_CLIENT_ID=

# Facebook OAuth App ID (Get from https://developers.facebook.com/)
VITE_FACEBOOK_APP_ID=

# Super Admin Security Keys (Required for Super Admin Access)
SUPER_ADMIN_KEY=
VITE_SUPER_ADMIN_PASSWORD=
VITE_BLOB_READ_WRITE_TOKEN=

# Gemini API Key (For AI generation)
VITE_GEMINI_API_KEY=

# Meta WhatsApp Cloud API (For automated messaging)
VITE_WA_PHONE_NUMBER_ID=
VITE_WA_ACCESS_TOKEN=
